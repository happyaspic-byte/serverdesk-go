# Optional host network preparation. Copy to /etc/serverdesk/network.env.
# Values are data, not shell; quotes, whitespace, substitutions, and unknown
# keys are rejected by serverdesk-network before it changes the host.

# Set both fields to add an IPv4 address owned by this service.
SERVERDESK_NET_INTERFACE=
SERVERDESK_AUX_ADDRESS=

# Enable only when devices send traps to privileged UDP/162 and Serverdesk
# listens on an unprivileged port. The target must match config.local.json.
SERVERDESK_ENABLE_TRAP_REDIRECT=false
SERVERDESK_TRAP_SOURCE_PORT=162
SERVERDESK_TRAP_TARGET_PORT=10162
