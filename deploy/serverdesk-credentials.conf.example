# Copy to /etc/systemd/system/serverdesk.service.d/credentials.conf.
# Optional read-only source for credentials provisioned outside the Manage UI.
# The default writable store is /var/lib/serverdesk/credentials and is selected
# with SERVERDESK_CREDENTIALS_STORE in the packaged unit. LoadCredential values
# are a lower-priority fallback; Serverdesk never writes CREDENTIALS_DIRECTORY.
[Service]
LoadCredential=cluster-1-admin-password:/etc/serverdesk/credentials/cluster-1-admin-password
LoadCredential=cluster-1-node-root-password:/etc/serverdesk/credentials/cluster-1-node-root-password
