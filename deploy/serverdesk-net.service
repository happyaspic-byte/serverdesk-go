[Unit]
Description=serverdesk optional auxiliary address and SNMP trap redirect
Documentation=https://github.com/happyaspic-byte/serverdesk-go
After=network-online.target
Wants=network-online.target
Before=serverdesk.service
ConditionPathExists=/etc/serverdesk/network.env

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=serverdesk-net
RuntimeDirectoryMode=0700
ExecStart=/opt/serverdesk/serverdesk-network --config /etc/serverdesk/network.env --state /run/serverdesk-net/applied.env apply
ExecStop=/opt/serverdesk/serverdesk-network --config /run/serverdesk-net/applied.env remove
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077

# This is the only Serverdesk component that needs a capability. The main
# daemon has an empty capability set. Configuration and program files remain
# read-only even while this helper updates the host network namespace.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
