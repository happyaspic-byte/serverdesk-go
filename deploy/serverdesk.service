[Unit]
Description=serverdesk-go — FT infrastructure monitoring console
Documentation=https://github.com/happyaspic-byte/serverdesk-go
After=network-online.target serverdesk-net.service
Wants=network-online.target serverdesk-net.service

[Service]
Type=simple
User=serverdesk
Group=serverdesk
WorkingDirectory=/var/lib/serverdesk
Environment=GOMEMLIMIT=400MiB
# This file is for non-secret runtime settings only. Device secrets belong in
# systemd credentials and are referenced as secret://NAME from config.local.json.
EnvironmentFile=-/etc/serverdesk/serverdesk.env
ExecStart=/opt/serverdesk/serverdesk -c /var/lib/serverdesk/config.local.json -auth /var/lib/serverdesk/auth.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

# The daemon and all collectors run unprivileged. Only the state directory is
# writable; program files, home directories, kernel state, and devices are not.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/serverdesk
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
