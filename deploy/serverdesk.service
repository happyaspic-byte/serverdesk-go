[Unit]
Description=serverdesk-go — FT 인프라 모니터링 콘솔 (Go 단일 바이너리)
# serverdesk-net(보조 IP + 트랩 162→10162 리다이렉트) 이후에 뜬다 — 트랩 경로 선행 확보.
After=network-online.target serverdesk-net.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/serverdesk-go
# 관리 토큰은 gitignore 된 로컬 env 파일에서 읽는다(리포에 비밀 금지).
# 없어도 기동된다(토큰 미설정 = 원격 쓰기 묵인 허용, 종전 동작).
EnvironmentFile=-/home/ubuntu/projects/serverdesk-go/serverdesk.local.env
ExecStart=/home/ubuntu/projects/serverdesk-go/serverdesk -c config.local.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
