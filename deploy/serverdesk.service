[Unit]
Description=serverdesk-go — FT infrastructure monitoring console
Documentation=https://github.com/happyaspic-byte/serverdesk-go
After=network-online.target serverdesk-net.service
Wants=network-online.target serverdesk-net.service

[Service]
Type=simple
User=serverdesk
Group=serverdesk
WorkingDirectory=/var/lib/serverdesk
Environment=GOMEMLIMIT=400MiB
# Writable, service-owned provider used by the Manage UI and CLI enrollment.
# Files are mode 0600 under the already-private state directory.
Environment=SERVERDESK_CREDENTIALS_STORE=/var/lib/serverdesk/credentials
# This file is for non-secret runtime settings only. Device secret values belong
# in the managed store/optional systemd source and config keeps secret://NAME.
EnvironmentFile=-/etc/serverdesk/serverdesk.env
ExecStart=/opt/serverdesk/serverdesk -c /var/lib/serverdesk/config.local.json -auth /var/lib/serverdesk/auth.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

# The daemon and all collectors run unprivileged. Only the state directory is
# writable; program files, home directories, kernel state, and devices are not.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
# Keep the host /proc view visible so runtime argv-exposure checks attest the
# same host-wide hidepid policy enforced by the installer for Stratus AVCLI.
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/serverdesk
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
